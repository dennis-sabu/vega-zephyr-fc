/*
 * aries_v3.overlay - DeviceTree Overlay for VEGA ARIES v3.0 Flight Controller
 * Target: C-DAC THEJAS32 SoC / VEGA ET1031 RISC-V @ 100 MHz
 *
 * Peripheral Mapping:
 * - UART0 @ 0x10000100 : GNSS NMEA Receiver (@ 9600 baud, 8N1)
 * - UART1 @ 0x10000200 : RC Receiver (SBUS @ 100,000 baud, 8E2)
 * - UART2 @ 0x10000300 : Telemetry / Debug Link (@ 115,200 baud, 8N1)
 * - GPIO1 @ 0x10180000 : General Purpose I/O (Pin 10 -> SD Card CS)
 * - SPI0  @ 0x10000600 : MicroSD Card Slot (SDHC-SPI Mode @ 25 MHz)
 * - I2C0  @ 0x10000800 : Shared Sensor Bus (MPU6050 @ 0x68, BMP280 @ 0x76, MAG @ 0x0D/0x1E)
 * - ADC0  @ 0x10001000 : Battery Voltage Monitor (Channel 0, scaled divider)
 * - PWM0  @ 0x10400000 : 8-Channel Timer PWM (Channels 0-3 for Quad-X ESCs @ 400 Hz)
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	chosen {
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
	};

	aliases {
		gnss-uart = &uart0;
		sbus-uart = &uart1;
		telemetry-uart = &uart2;
		imu-i2c = &i2c0;
		baro-i2c = &i2c0;
		mag-i2c = &i2c0;
		motor-pwm = &pwm0;
		battery-adc = &adc0;
		spi0 = &spi0;
		sdhc0 = &sdhc0;
	};

	soc {
		spi0: spi@10000600 {
			compatible = "cdac,thejas32-spi";
			reg = <0x10000600 0x14>;
			#address-cells = <1>;
			#size-cells = <0>;
			cs-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
			status = "okay";

			sdhc0: sdhc@0 {
				compatible = "zephyr,sdhc-spi-slot";
				reg = <0>;
				status = "okay";
				spi-max-frequency = <25000000>;
				mmc {
					compatible = "zephyr,sdmmc-disk";
					status = "okay";
					disk-name = "SD";
				};
			};
		};

		i2c0: i2c@10000800 {
			compatible = "cdac,thejas32-i2c";
			reg = <0x10000800 0x0b>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			status = "okay";
		};

		adc0: adc@10001000 {
			compatible = "cdac,thejas32-adc";
			reg = <0x10001000 0x0c>;
			#io-channel-cells = <1>;
			status = "okay";
		};

		pwm0: pwm@10400000 {
			compatible = "cdac,thejas32-pwm";
			reg = <0x10400000 0x90>;
			#pwm-cells = <3>;
			status = "okay";
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <9600>;
};

&uart1 {
	status = "okay";
	current-speed = <100000>;
};

&uart2 {
	status = "okay";
	current-speed = <115200>;
};
